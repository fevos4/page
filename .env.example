DATABASE_URL="postgresql://postgres:postgres@localhost:5433/zahravideo?schema=public" # pooled -- used at runtime
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/zahravideo?schema=public"   # direct -- used for migrations

# Storage Connection (Cloudflare R2 for Production, MinIO / Docker S3 for Local Dev)
STORAGE_PROVIDER="minio" # Set to "r2" in production
STORAGE_BUCKET="videos"

# MinIO Local Configuration
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

# Cloudflare R2 Production Configuration
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"

# Backblaze B2 Storage Configuration
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_KEY_ID="your_b2_application_key_id_here"
B2_APPLICATION_KEY="your_b2_application_key_secret_here"

# Session & Auth
SESSION_SECRET="super-secret-zahra-platform-key-change-in-production-32bytes"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron Handler Secret
CRON_SECRET="zahra-cron-secret-key-change-in-production"

# Resend Transactional Email Key
# Note: Ensure sending domain is verified in the Resend dashboard prior to production use.
# Until domain verification is completed, Resend operates in testing mode.
RESEND_API_KEY="re_123456789_your_resend_api_key_here"
