# Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/zahravideo?schema=public"

# MinIO / S3 Storage Configuration
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="videos"

# Session & Auth
SESSION_SECRET="super-secret-zahra-platform-key-change-in-production-32bytes"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron Handler Secret
CRON_SECRET="zahra-cron-secret-key-change-in-production"

# Resend Transactional Email Key
# Note: Ensure sending domain is verified in the Resend dashboard prior to production use.
# Until domain verification is completed, Resend operates in testing mode.
RESEND_API_KEY="re_123456789_your_resend_api_key_here"

